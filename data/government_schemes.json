[
    {
        "id": "standup_india",
        "name_en": "Stand-Up India Scheme",
        "name_ta": "\u0bb8\u0bcd\u0b9f\u0bbe\u0ba3\u0bcd\u0b9f\u0bcd-\u0b85\u0baa\u0bcd \u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0baf\u0bbe \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd",
        "name_hi": "\u0938\u094d\u091f\u0948\u0902\u0921-\u0986\u09aa \u0987\u09a8\u09cd\u09a1\u09bf\u09af\u09bc\u09be \u092f\u094b\u091c\u0928\u093e",
        "description_en": "Promotes entrepreneurship among women and SC/ST communities by providing bank loans between \u20b910 Lakhs and \u20b91 Crore.",
        "description_ta": "\u0baa\u0bc6\u0ba3\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd SC/ST \u0b9a\u0bae\u0bc2\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bb0\u0bbf\u0b9f\u0bc8\u0baf\u0bc7 \u0bb0\u0bc2. 10 \u0bb2\u0b9f\u0bcd\u0b9a\u0bae\u0bcd \u0bae\u0bc1\u0ba4\u0bb2\u0bcd \u0bb0\u0bc2. 1 \u0b95\u0bcb\u0b9f\u0bbf \u0bb5\u0bb0\u0bc8\u0baf\u0bbf\u0bb2\u0bbe\u0ba9 \u0bb5\u0b99\u0bcd\u0b95\u0bbf \u0b95\u0b9f\u0ba9\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bc2\u0bb2\u0bae\u0bcd \u0ba4\u0bca\u0bb4\u0bbf\u0bb2\u0bcd\u0bae\u0bc1\u0ba9\u0bc8\u0bb5\u0bcb\u0bb0\u0bc8 \u0b8a\u0b95\u0bcd\u0b95\u0bc1\u0bb5\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0ba4\u0bc1.",
        "description_hi": "\u092e\u0939\u093f\u0932\u093e\u0913\u0902 \u0914\u0930 \u090f\u0938\u0938\u0940/\u090f\u0938\u091f\u0940 \u0938\u092e\u0941\u0926\u093e\u092f\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a 10 \u0932\u093e\u0916 \u0930\u0941\u092a\u092f\u0947 \u0938\u0947 1 \u0915\u0930\u094b\u0921\u093c \u0930\u0941\u092a\u092f\u0947 \u0915\u0947 \u092c\u0940\u091a \u092c\u0948\u0902\u0915 \u090b\u0923 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0915\u0947 \u0909\u0926\u094d\u092f\u092e\u093f\u0924\u093e \u0915\u094b \u092c\u0922\u093c\u093e\u0935\u093e \u0926\u0947\u0924\u093e \u0939\u0948\u0964",
        "benefits_en": "Bank loan covering 75% of greenfield project costs between \u20b910 Lakhs and \u20b91 Crore. Repayment period up to 7 years.",
        "benefits_ta": "\u20b910 \u0bb2\u0b9f\u0bcd\u0b9a\u0bae\u0bcd \u0bae\u0bc1\u0ba4\u0bb2\u0bcd \u20b91 \u0b95\u0bcb\u0b9f\u0bbf \u0bb5\u0bb0\u0bc8\u0baf\u0bbf\u0bb2\u0bbe\u0ba9 \u0baa\u0bc1\u0ba4\u0bbf\u0baf \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0b9a\u0bcd \u0b9a\u0bc6\u0bb2\u0bb5\u0bbf\u0bb2\u0bcd 75% \u0bb5\u0bb0\u0bc8 \u0bb5\u0b99\u0bcd\u0b95\u0bbf \u0b95\u0b9f\u0ba9\u0bcd. \u0ba4\u0bbf\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0b9a\u0bcd \u0b9a\u0bc6\u0bb2\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bae\u0bcd \u0b95\u0bbe\u0bb2\u0bae\u0bcd 7 \u0b86\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bb3\u0bcd \u0bb5\u0bb0\u0bc8.",
        "benefits_hi": "\u20b910 \u0932\u093e\u0916 \u0914\u0930 \u20b91 \u0915\u0930\u094b\u0921\u093c \u0915\u0947 \u092c\u0940\u091a \u0917\u094d\u0930\u0940\u0928\u092b\u0940\u0932\u094d\u0921 \u092a\u0930\u093f\u092f\u094b\u091c\u0928\u093e \u0932\u093e\u0917\u0924 \u0915\u093e 75% \u0915\u0935\u0930 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u093e \u092c\u0948\u0902\u0915 \u090b\u0923\u0964 \u091a\u0941\u0915\u094c\u0924\u0940 \u0905\u0935\u0927\u093f 7 \u0935\u0930\u094d\u0937 \u0924\u0915\u0964",
        "official_link": "https://www.standupmitra.in",
        "required_documents": [
            {
                "id": "category_proof",
                "name_en": "Caste/Category Certificate (SC/ST) or Female Ownership Proof",
                "name_ta": "\u0b9a\u0bbe\u0ba4\u0bbf \u0b9a\u0bbe\u0ba9\u0bcd\u0bb1\u0bbf\u0ba4\u0bb4\u0bcd (SC/ST) \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0baa\u0bc6\u0ba3\u0bcd \u0b89\u0bb0\u0bbf\u0bae\u0bc8\u0baf\u0bbe\u0bb3\u0bb0\u0bcd \u0b9a\u0bbe\u0ba9\u0bcd\u0bb1\u0bc1",
                "name_hi": "\u091c\u093e\u0924\u093f/\u0936\u094d\u0930\u0947\u0923\u0940 \u092a\u094d\u0930\u092e\u093e\u0923 \u092a\u0924\u094d\u0930 (\u090f\u0938\u0938\u0940/\u090f\u0938\u091f\u0940) \u092f\u093e \u092e\u0939\u093f\u0932\u093e \u0938\u094d\u0935\u093e\u092e\u093f\u0924\u094d\u0935 \u0915\u093e \u092a\u094d\u0930\u092e\u093e\u0923"
            },
            {
                "id": "business_incorporation",
                "name_en": "Partnership Deed / Incorporation Certificate",
                "name_ta": "\u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0bbe\u0ba3\u0bcd\u0bae\u0bc8 \u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bae\u0bcd / \u0ba8\u0bbf\u0bb1\u0bc1\u0bb5\u0ba9 \u0b92\u0bb0\u0bc1\u0b99\u0bcd\u0b95\u0bbf\u0ba3\u0bc8\u0baa\u0bcd\u0baa\u0bc1 \u0b9a\u0bbe\u0ba9\u0bcd\u0bb1\u0bbf\u0ba4\u0bb4\u0bcd",
                "name_hi": "\u0938\u093e\u091d\u0947\u0926\u093e\u0930\u0940 \u0935\u093f\u0932\u0947\u0916 / \u0928\u093f\u0917\u092e\u0928 \u092a\u094d\u0930\u092e\u093e\u0923 \u092a\u0924\u094d\u0930"
            },
            {
                "id": "project_report",
                "name_en": "Detailed Project Report (DPR)",
                "name_ta": "\u0bb5\u0bbf\u0bb0\u0bbf\u0bb5\u0bbe\u0ba9 \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f \u0b85\u0bb1\u0bbf\u0b95\u0bcd\u0b95\u0bc8 (DPR)",
                "name_hi": "\u0935\u093f\u0938\u094d\u0924\u0943\u0924 \u092a\u0930\u093f\u092f\u094b\u091c\u0928\u093e \u0930\u093f\u092a\u094b\u0930\u094d\u091f (DPR)"
            }
        ],
        "rules": {
            "enterprise_categories": [
                "Micro",
                "Small",
                "Medium"
            ],
            "sectors": [
                "Manufacturing",
                "Services",
                "Retail & Trading"
            ],
            "min_loan_requirement": 1000000,
            "max_loan_requirement": 10000000,
            "requires_udyam": false,
            "requires_gst": false,
            "owner_gender": [
                "Female"
            ],
            "owner_social_category": [
                "SC",
                "ST"
            ]
        }
    },
    {
        "id": "pmegp",
        "name_en": "Prime Minister's Employment Generation Programme (PMEGP)",
        "name_ta": "\u0baa\u0bbf\u0bb0\u0ba4\u0bae\u0bb0\u0bbf\u0ba9\u0bcd \u0bb5\u0bc7\u0bb2\u0bc8\u0bb5\u0bbe\u0baf\u0bcd\u0baa\u0bcd\u0baa\u0bc1 \u0b89\u0bb0\u0bc1\u0bb5\u0bbe\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd (PMEGP)",
        "name_hi": "\u092a\u094d\u0930\u0927\u093e\u0928\u092e\u0902\u0924\u094d\u0930\u0940 \u0930\u094b\u091c\u0917\u093e\u0930 \u0938\u0943\u091c\u0928 \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e (PMEGP)",
        "description_en": "Subsidy scheme for setting up new micro-enterprises, generating self-employment in manufacturing and service sectors.",
        "description_ta": "\u0baa\u0bc1\u0ba4\u0bbf\u0baf \u0b95\u0bc1\u0bb1\u0bc1 \u0ba8\u0bbf\u0bb1\u0bc1\u0bb5\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bc8 \u0b85\u0bae\u0bc8\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0bae\u0bcd, \u0b89\u0bb1\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0bc7\u0bb5\u0bc8\u0ba4\u0bcd \u0ba4\u0bc1\u0bb1\u0bc8\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0b9a\u0bc1\u0baf\u0bb5\u0bc7\u0bb2\u0bc8\u0bb5\u0bbe\u0baf\u0bcd\u0baa\u0bcd\u0baa\u0bc8 \u0b89\u0bb0\u0bc1\u0bb5\u0bbe\u0b95\u0bcd\u0b95\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0bae\u0bbe\u0ba9 \u0bae\u0bbe\u0ba9\u0bbf\u0baf\u0ba4\u0bcd \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd.",
        "description_hi": "\u0928\u090f \u0938\u0942\u0915\u094d\u0937\u094d\u092e \u0909\u0926\u094d\u092f\u092e\u094b\u0902 \u0915\u0940 \u0938\u094d\u0925\u093e\u092a\u0928\u093e \u0915\u0947 \u0932\u093f\u090f \u0938\u092c\u094d\u0938\u093f\u0921\u0940 \u092f\u094b\u091c\u0928\u093e, \u0935\u093f\u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u0914\u0930 \u0938\u0947\u0935\u093e \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u094b\u0902 \u092e\u0947\u0902 \u0938\u094d\u0935-\u0930\u094b\u091c\u0917\u093e\u0930 \u092a\u0948\u0926\u093e \u0915\u0930\u0928\u093e\u0964",
        "benefits_en": "Government subsidy of 15% to 35% depending on area (rural/urban) and social category. Maximum project cost \u20b950 Lakhs for Manufacturing.",
        "benefits_ta": "\u0baa\u0b95\u0bc1\u0ba4\u0bbf (\u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0baa\u0bcd\u0baa\u0bc1\u0bb1\u0bae\u0bcd/\u0ba8\u0b95\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bc1\u0bb1\u0bae\u0bcd) \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0bae\u0bc2\u0b95\u0baa\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bb5\u0bc8\u0baa\u0bcd \u0baa\u0bca\u0bb1\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1 15% \u0bae\u0bc1\u0ba4\u0bb2\u0bcd 35% \u0bb5\u0bb0\u0bc8 \u0bae\u0bbe\u0ba9\u0bbf\u0baf\u0bae\u0bcd. \u0b89\u0bb1\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0ba4\u0bcd \u0ba4\u0bc1\u0bb1\u0bc8\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0ba4\u0bbf\u0b95\u0baa\u0b9f\u0bcd\u0b9a \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0b9a\u0bcd \u0b9a\u0bc6\u0bb2\u0bb5\u0bc1 \u20b950 \u0bb2\u0b9f\u0bcd\u0b9a\u0bae\u0bcd.",
        "benefits_hi": "\u0915\u094d\u0937\u0947\u0924\u094d\u0930 (\u0917\u094d\u0930\u093e\u092e\u0940\u0923/\u0936\u0939\u0930\u0940) \u0914\u0930 \u0938\u093e\u092e\u093e\u091c\u093f\u0915 \u0936\u094d\u0930\u0947\u0923\u0940 \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 15% \u0938\u0947 35% \u0915\u0940 \u0938\u0930\u0915\u093e\u0930\u0940 \u0938\u092c\u094d\u0938\u093f\u0921\u0940\u0964 \u0935\u093f\u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u0915\u0947 \u0932\u093f\u090f \u0905\u0927\u093f\u0915\u0924\u092e \u092a\u0930\u093f\u092f\u094b\u091c\u0928\u093e \u0932\u093e\u0917\u0924 \u20b950 \u0932\u093e\u0916\u0964",
        "official_link": "https://www.kviconline.gov.in/pmegpeportal",
        "required_documents": [
            {
                "id": "aadhaar_card",
                "name_en": "Aadhaar Card",
                "name_ta": "\u0b86\u0ba4\u0bbe\u0bb0\u0bcd \u0b85\u0b9f\u0bcd\u0b9f\u0bc8",
                "name_hi": "\u0906\u0927\u093e\u0930 \u0915\u093e\u0930\u094d\u0921"
            },
            {
                "id": "education_proof",
                "name_en": "Educational Qualification Certificate (8th Pass or higher)",
                "name_ta": "\u0b95\u0bb2\u0bcd\u0bb5\u0bbf \u0ba4\u0b95\u0bc1\u0ba4\u0bbf \u0b9a\u0bbe\u0ba9\u0bcd\u0bb1\u0bbf\u0ba4\u0bb4\u0bcd (8-\u0b86\u0bae\u0bcd \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u0baa\u0bc1 \u0ba4\u0bc7\u0bb0\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0b85\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0bae\u0bc7\u0bb2\u0bcd)",
                "name_hi": "\u0936\u0948\u0915\u094d\u0937\u0923\u093f\u0915 \u092f\u094b\u0917\u094d\u092f\u0924\u093e \u092a\u094d\u0930\u092e\u093e\u0923 \u092a\u0924\u094d\u0930 (8\u0935\u0940\u0902 \u092a\u093e\u0938 \u092f\u093e \u0909\u091a\u094d\u091a\u0924\u0930)"
            },
            {
                "id": "project_report",
                "name_en": "Project Report / Business Plan",
                "name_ta": "\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f \u0b85\u0bb1\u0bbf\u0b95\u0bcd\u0b95\u0bc8 / \u0bb5\u0ba3\u0bbf\u0b95 \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd",
                "name_hi": "\u092a\u0930\u093f\u092f\u094b\u091c\u0928\u093e \u0930\u093f\u092a\u094b\u0930\u094d\u091f / \u0935\u094d\u092f\u093e\u0935\u0938\u093e\u092f\u093f\u0915 \u092f\u094b\u091c\u0928\u093e"
            }
        ],
        "rules": {
            "enterprise_categories": [
                "Micro"
            ],
            "sectors": [
                "Manufacturing",
                "Services"
            ],
            "max_loan_requirement": 5000000,
            "requires_udyam": false,
            "requires_gst": false
        }
    },
    {
        "id": "zed",
        "name_en": "MSME Sustainable (ZED) Certification Scheme",
        "name_ta": "MSME \u0ba8\u0bbf\u0bb2\u0bc8\u0baf\u0bbe\u0ba9 (ZED) \u0b9a\u0bbe\u0ba9\u0bcd\u0bb1\u0bbf\u0ba4\u0bb4\u0bcd \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd",
        "name_hi": "\u090f\u092e\u090f\u0938\u090f\u092e\u0908 \u0938\u0924\u0924 (\u091c\u0947\u0921) \u092a\u094d\u0930\u092e\u093e\u0923\u0928 \u092f\u094b\u091c\u0928\u093e",
        "description_en": "Assists manufacturing MSMEs in adopting Zero Defect Zero Effect processes, offering certification subsidies and audit grants.",
        "description_ta": "\u0baa\u0bc2\u0b9c\u0bcd\u0b9c\u0bbf\u0baf \u0b95\u0bc1\u0bb1\u0bc8\u0baa\u0bbe\u0b9f\u0bc1 \u0baa\u0bc2\u0b9c\u0bcd\u0b9c\u0bbf\u0baf \u0baa\u0bbe\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc1 (Zero Defect Zero Effect) \u0b89\u0bb1\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf \u0bae\u0bc1\u0bb1\u0bc8\u0b95\u0bb3\u0bc8\u0baa\u0bcd \u0baa\u0bbf\u0ba9\u0bcd\u0baa\u0bb1\u0bcd\u0bb1 \u0b89\u0ba4\u0bb5\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1, \u0b9a\u0bbe\u0ba9\u0bcd\u0bb1\u0bbf\u0ba4\u0bb4\u0bcd \u0bae\u0bbe\u0ba9\u0bbf\u0baf\u0bae\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1.",
        "description_hi": "\u0935\u093f\u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u090f\u092e\u090f\u0938\u090f\u092e\u0908 \u0915\u094b \u0936\u0942\u0928\u094d\u092f \u0926\u094b\u0937 \u0936\u0942\u0928\u094d\u092f \u092a\u094d\u0930\u092d\u093e\u0935 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e\u0913\u0902 \u0915\u094b \u0905\u092a\u0928\u093e\u0928\u0947 \u092e\u0947\u0902 \u0938\u0939\u093e\u092f\u0924\u093e \u0915\u0930\u0924\u093e \u0939\u0948, \u092a\u094d\u0930\u092e\u093e\u0923\u0928 \u0938\u092c\u094d\u0938\u093f\u0921\u0940 \u0915\u0940 \u092a\u0947\u0936\u0915\u0936 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",
        "benefits_en": "Subsidies on certification fee (80% for Micro, 60% for Small, 50% for Medium). Testing and audit support up to \u20b95.5 Lakhs.",
        "benefits_ta": "\u0b9a\u0bbe\u0ba9\u0bcd\u0bb1\u0bbf\u0ba4\u0bb4\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0bae\u0bbe\u0ba9\u0bbf\u0baf\u0bae\u0bcd (\u0b95\u0bc1\u0bb1\u0bc1 \u0ba8\u0bbf\u0bb1\u0bc1\u0bb5\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 80%, \u0b9a\u0bbf\u0bb1\u0bc1 \u0ba8\u0bbf\u0bb1\u0bc1\u0bb5\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 60%, \u0ba8\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bb0 \u0ba8\u0bbf\u0bb1\u0bc1\u0bb5\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 50%). \u0b9a\u0bcb\u0ba4\u0ba9\u0bc8/\u0ba4\u0ba3\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u20b95.5 \u0bb2\u0b9f\u0bcd\u0b9a\u0bae\u0bcd \u0bb5\u0bb0\u0bc8 \u0b89\u0ba4\u0bb5\u0bbf.",
        "benefits_hi": "\u092a\u094d\u0930\u092e\u093e\u0923\u0928 \u0936\u0941\u0932\u094d\u0915 \u092a\u0930 \u0938\u092c\u094d\u0938\u093f\u0921\u0940 (\u0938\u0942\u0915\u094d\u0937\u094d\u092e \u0915\u0947 \u0932\u093f\u090f 80%, \u0932\u0918\u0941 \u0915\u0947 \u0932\u093f\u090f 60%, \u092e\u0927\u094d\u092f\u092e \u0915\u0947 \u0932\u093f\u090f 50%)\u0964 \u20b95.5 \u0932\u093e\u0916 \u0924\u0915 \u0915\u093e \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0914\u0930 \u0911\u0921\u093f\u091f \u0938\u092e\u0930\u094d\u0925\u0928\u0964",
        "official_link": "https://zed.msme.gov.in",
        "required_documents": [
            {
                "id": "udyam_certificate",
                "name_en": "Udyam/MSME Registration Certificate",
                "name_ta": "\u0b89\u0ba4\u0bcd\u0baf\u0bae\u0bcd/MSME \u0baa\u0ba4\u0bbf\u0bb5\u0bc1 \u0b9a\u0bbe\u0ba9\u0bcd\u0bb1\u0bbf\u0ba4\u0bb4\u0bcd",
                "name_hi": "\u0909\u0926\u094d\u092f\u092e/\u090f\u092e\u090f\u0938\u090f\u092e\u0908 \u092a\u0902\u091c\u0940\u0915\u0930\u0923 \u092a\u094d\u0930\u092e\u093e\u0923 \u092a\u0924\u094d\u0930"
            },
            {
                "id": "gst_certificate",
                "name_en": "GST Registration Certificate",
                "name_ta": "\u0b9c\u0bbf\u0b8e\u0bb8\u0bcd\u0b9f\u0bbf \u0baa\u0ba4\u0bbf\u0bb5\u0bc1 \u0b9a\u0bbe\u0ba9\u0bcd\u0bb1\u0bbf\u0ba4\u0bb4\u0bcd",
                "name_hi": "\u091c\u0940\u090f\u0938\u091f\u0940 \u092a\u0902\u091c\u0940\u0915\u0930\u0923 \u092a\u094d\u0930\u092e\u093e\u0923 \u092a\u0924\u094d\u0930"
            }
        ],
        "rules": {
            "enterprise_categories": [
                "Micro",
                "Small",
                "Medium"
            ],
            "sectors": [
                "Manufacturing"
            ],
            "requires_udyam": true,
            "requires_gst": true
        }
    },
    {
        "id": "cgtmse",
        "name_en": "Credit Guarantee Fund Trust (CGTMSE)",
        "name_ta": "\u0b95\u0b9f\u0ba9\u0bcd \u0b89\u0ba4\u0bcd\u0ba4\u0bb0\u0bb5\u0bbe\u0ba4 \u0ba8\u0bbf\u0ba4\u0bbf \u0b85\u0bb1\u0b95\u0bcd\u0b95\u0b9f\u0bcd\u0b9f\u0bb3\u0bc8 (CGTMSE)",
        "name_hi": "\u0915\u094d\u0930\u0947\u0921\u093f\u091f \u0917\u093e\u0930\u0902\u091f\u0940 \u092b\u0902\u0921 \u091f\u094d\u0930\u0938\u094d\u091f (CGTMSE)",
        "description_en": "Enables micro and small enterprises to access collateral-free bank credit up to \u20b95 Crores with government guarantee cover.",
        "description_ta": "\u0b95\u0bc1\u0bb1\u0bc1 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0bbf\u0bb1\u0bc1 \u0ba8\u0bbf\u0bb1\u0bc1\u0bb5\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bb0\u0bc2. 5 \u0b95\u0bcb\u0b9f\u0bbf \u0bb5\u0bb0\u0bc8 \u0baa\u0bbf\u0ba3\u0bc8\u0baf\u0bbf\u0bb2\u0bcd\u0bb2\u0bbe \u0bb5\u0b99\u0bcd\u0b95\u0bbf \u0b95\u0b9f\u0ba9\u0bc8 \u0b85\u0bb0\u0b9a\u0bc1 \u0b89\u0ba4\u0bcd\u0ba4\u0bb0\u0bb5\u0bbe\u0ba4\u0ba4\u0bcd\u0ba4\u0bc1\u0b9f\u0ba9\u0bcd \u0baa\u0bc6\u0bb1 \u0b89\u0ba4\u0bb5\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1.",
        "description_hi": "\u0938\u0942\u0915\u094d\u0937\u094d\u092e \u0914\u0930 \u0932\u0918\u0941 \u0909\u0926\u094d\u092f\u092e\u094b\u0902 \u0915\u094b \u0938\u0930\u0915\u093e\u0930\u0940 \u0917\u093e\u0930\u0902\u091f\u0940 \u0915\u0935\u0930 \u0915\u0947 \u0938\u093e\u0925 \u20b95 \u0915\u0930\u094b\u0921\u093c \u0924\u0915 \u0938\u0902\u092a\u093e\u0930\u094d\u0936\u094d\u0935\u093f\u0915-\u092e\u0941\u0915\u094d\u0924 \u092c\u0948\u0902\u0915 \u090b\u0923 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0938\u0915\u094d\u0937\u092e \u092c\u0928\u093e\u0924\u093e \u0939\u0948\u0964",
        "benefits_en": "Credit guarantee cover of up to 85% for loans up to \u20b95 Crores. Promotes credit flow without requiring collateral or third-party guarantee.",
        "benefits_ta": "\u20b95 \u0b95\u0bcb\u0b9f\u0bbf \u0bb5\u0bb0\u0bc8\u0baf\u0bbf\u0bb2\u0bbe\u0ba9 \u0b95\u0b9f\u0ba9\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 85% \u0bb5\u0bb0\u0bc8 \u0b95\u0b9f\u0ba9\u0bcd \u0b89\u0ba4\u0bcd\u0ba4\u0bb0\u0bb5\u0bbe\u0ba4\u0b95\u0bcd \u0b95\u0bbe\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bc1. \u0baa\u0bbf\u0ba3\u0bc8 \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0bae\u0bc2\u0ba9\u0bcd\u0bb1\u0bbe\u0bae\u0bcd \u0ba4\u0bb0\u0baa\u0bcd\u0baa\u0bc1 \u0b89\u0ba4\u0bcd\u0ba4\u0bb0\u0bb5\u0bbe\u0ba4\u0bae\u0bcd \u0ba4\u0bc7\u0bb5\u0bc8\u0baf\u0bbf\u0bb2\u0bcd\u0bb2\u0bc8.",
        "benefits_hi": "\u20b95 \u0915\u0930\u094b\u0921\u093c \u0924\u0915 \u0915\u0947 \u090b\u0923 \u0915\u0947 \u0932\u093f\u090f 85% \u0924\u0915 \u0915\u094d\u0930\u0947\u0921\u093f\u091f \u0917\u093e\u0930\u0902\u091f\u0940 \u0915\u0935\u0930\u0964 \u0938\u0902\u092a\u093e\u0930\u094d\u0936\u094d\u0935\u093f\u0915 \u092f\u093e \u0924\u0940\u0938\u0930\u0947 \u092a\u0915\u094d\u0937 \u0915\u0940 \u0917\u093e\u0930\u0902\u091f\u0940 \u0915\u0947 \u092c\u093f\u0928\u093e \u090b\u0923 \u092a\u094d\u0930\u0935\u093e\u0939 \u0915\u094b \u092c\u0922\u093c\u093e\u0935\u093e \u0926\u0947\u0924\u093e \u0939\u0948\u0964",
        "official_link": "https://www.cgtmse.in",
        "required_documents": [
            {
                "id": "udyam_certificate",
                "name_en": "Udyam/MSME Registration Certificate",
                "name_ta": "\u0b89\u0ba4\u0bcd\u0baf\u0bae\u0bcd/MSME \u0baa\u0ba4\u0bbf\u0bb5\u0bc1 \u0b9a\u0bbe\u0ba9\u0bcd\u0bb1\u0bbf\u0ba4\u0bb4\u0bcd",
                "name_hi": "\u0909\u0926\u094d\u092f\u092e/\u090f\u092e\u090f\u0938\u090f\u092e\u0908 \u092a\u0902\u091c\u0940\u0915\u0930\u0923 \u092a\u094d\u0930\u092e\u093e\u0923 \u092a\u0924\u094d\u0930"
            },
            {
                "id": "financial_statements",
                "name_en": "Audited Financial Statements (Last 2 Years)",
                "name_ta": "\u0ba4\u0ba3\u0bbf\u0b95\u0bcd\u0b95\u0bc8 \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba8\u0bbf\u0ba4\u0bbf \u0b85\u0bb1\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0b95\u0bb3\u0bcd (\u0b95\u0b9f\u0ba8\u0bcd\u0ba4 2 \u0b86\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bb3\u0bcd)",
                "name_hi": "\u0911\u0921\u093f\u091f \u0915\u093f\u090f \u0917\u090f \u0935\u093f\u0924\u094d\u0924\u0940\u092f \u0935\u093f\u0935\u0930\u0923 (\u092a\u093f\u091b\u0932\u0947 2 \u0935\u0930\u094d\u0937)"
            }
        ],
        "rules": {
            "enterprise_categories": [
                "Micro",
                "Small"
            ],
            "sectors": [
                "Manufacturing",
